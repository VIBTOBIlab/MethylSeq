nextflow_pipeline {

    name "Test Workflow main.nf"
    script "../main.nf"

    tag "bismark"
    tag "pipeline"

    test("Params: default with methurator") {
        when {
            params {
                aligner        = "bismark"
                save_reference = true
                outdir         = "$outputDir"
                run_methurator = true
            }
        }

        then {
            assert workflow.success
            assert snapshot(path("$outputDir/methurator/summaries/Ecoli/methurator_summary.yml").readLines()[3..10].join('\n').md5()).match()
        }
    }

    test("Bismark Single-End") {
        when {
            params {
                aligner        = "bismark"
                save_reference = true
                outdir         = "$outputDir"
                run_methurator = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                            path("$outputDir/bismark/methylation_calls/bedGraph/Ecoli.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/SRR389222.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/mbias/Ecoli.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/mbias/SRR389222.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/Ecoli.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/SRR389222.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_calls/").list(),
                            path("$outputDir/bismark/methylation_calls/splitting_report/Ecoli.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/bismark/methylation_calls/splitting_report/SRR389222.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/bismark/reference_genome/BismarkIndex/").list(),
                            path("$outputDir/qualimap/Ecoli/genome_results.txt"),
                            path("$outputDir/qualimap/SRR389222/genome_results.txt")).match("single_end") },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml")).match("single_end_software_versions") },
                { assert new File("$outputDir/bismark/alignments/logs/Ecoli_1_val_1_bismark_bt2_PE_report.txt").exists() },
                { assert new File("$outputDir/bismark/alignments/logs/SRR389222_trimmed_bismark_bt2_SE_report.txt").exists() },
                { assert new File("$outputDir/bismark/reports/Ecoli_1_val_1_bismark_bt2_PE_report.html").exists() },
                { assert new File("$outputDir/bismark/reports/SRR389222_trimmed_bismark_bt2_SE_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.txt").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_1_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_2_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/SRR389222_fastqc.html").exists() },
                { assert new File("$outputDir/multiqc/bismark/multiqc_report.html").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_1.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_2.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/SRR389222.fastq.gz_trimming_report.txt").exists() }
            )
        }
    }

    test("Bismark Single-End With Index") {
        when {
            params {
                aligner         = "bismark"
                bismark_index   = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bowtie2_Index.tar.gz"
                cytosine_report = true
                run_methurator  = false
                outdir          = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
            )
        }
    }

    test("Bismark Single-End With RRBS") {
        when {
            params {
                aligner        = "bismark"
                skip_trimming  = true
                save_reference = true
                rrbs           = true
                run_methurator = false
                outdir         = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                            path("$outputDir/bismark/methylation_calls/bedGraph/Ecoli.markdup.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/SRR389222.markdup.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/mbias/Ecoli.markdup.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/mbias/SRR389222.markdup.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/Ecoli.markdup.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/SRR389222.markdup.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_calls/").list(),
                            path("$outputDir/bismark/methylation_calls/splitting_report/Ecoli.markdup_splitting_report.txt"),
                            path("$outputDir/bismark/methylation_calls/splitting_report/SRR389222.markdup_splitting_report.txt"),
                            path("$outputDir/bismark/reference_genome/BismarkIndex/").list(),
                            path("$outputDir/qualimap/Ecoli/genome_results.txt"),
                            path("$outputDir/qualimap/SRR389222/genome_results.txt")).match("single_end_rrbs") },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml")).match("single_end_rrbs_software_versions") },
                { assert new File("$outputDir/bismark/alignments/logs/Ecoli_10K_methylated_R1_bismark_bt2_PE_report.txt").exists() },
                { assert new File("$outputDir/bismark/alignments/logs/SRR389222.merged_bismark_bt2_SE_report.txt").exists() },
                { assert new File("$outputDir/bismark/reports/Ecoli_10K_methylated_R1_bismark_bt2_PE_report.html").exists() },
                { assert new File("$outputDir/bismark/reports/SRR389222.merged_bismark_bt2_SE_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.txt").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_1_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_2_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/SRR389222_fastqc.html").exists() },
                { assert new File("$outputDir/multiqc/bismark/multiqc_report.html").exists() }
            )
        }
    }

    test("Bismark Single-End With RRBS With Index") {
        when {
            params {
                aligner         = "bismark"
                skip_trimming   = true
                run_methurator  = false
                rrbs            = true
                bismark_index   = "https://github.com/nf-core/test-datasets/raw/methylseq/reference/Bowtie2_Index.tar.gz"
                cytosine_report = true
                outdir          = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
            )
        }
    }

    test("Bismark Single-End NOMe-seq") {
        when {
            params {
                aligner = "bismark"
                nomeseq = true
                outdir = "$outputDir"
                run_methurator = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(path("$outputDir/bismark/coverage2cytosine/coverage/Ecoli.NOMe.CpG.cov.gz"),
                            path("$outputDir/bismark/coverage2cytosine/coverage/Ecoli.NOMe.GpC.cov.gz"),
                            path("$outputDir/bismark/coverage2cytosine/coverage/SRR389222.NOMe.CpG.cov.gz"),
                            path("$outputDir/bismark/coverage2cytosine/coverage/SRR389222.NOMe.GpC.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/Ecoli.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/SRR389222.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/mbias/Ecoli.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/mbias/SRR389222.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/Ecoli.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/SRR389222.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_calls/").list(),
                            path("$outputDir/bismark/methylation_calls/splitting_report/Ecoli.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/bismark/methylation_calls/splitting_report/SRR389222.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/cat/SRR389222.merged.fastq.gz"),
                            path("$outputDir/qualimap/Ecoli/genome_results.txt"),
                            path("$outputDir/qualimap/SRR389222/genome_results.txt")).match("single_end_nomeseq") },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml")).match("single_end_nomeseq_software_versions") },
                { assert new File("$outputDir/bismark/alignments/logs/Ecoli_1_val_1_bismark_bt2_PE_report.txt").exists() },
                { assert new File("$outputDir/bismark/alignments/logs/SRR389222_trimmed_bismark_bt2_SE_report.txt").exists() },
                { assert new File("$outputDir/bismark/reports/Ecoli_1_val_1_bismark_bt2_PE_report.html").exists() },
                { assert new File("$outputDir/bismark/reports/SRR389222_trimmed_bismark_bt2_SE_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.txt").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_1_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_2_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/SRR389222_fastqc.html").exists() },
                { assert new File("$outputDir/multiqc/bismark/multiqc_report.html").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_1.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_2.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/SRR389222.fastq.gz_trimming_report.txt").exists() }
            )
        }
    }

    test("Bismark Clip R1 - 2") {
        when {
            params {
                aligner = "bismark"
                em_seq  = true
                clip_r1 = 2
                outdir  = "$outputDir"
                run_methurator = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                            path("$outputDir/bismark/methylation_calls/bedGraph/Ecoli.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/SRR389222.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/mbias/Ecoli.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/mbias/SRR389222.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/Ecoli.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/SRR389222.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_calls/").list(),
                            path("$outputDir/bismark/methylation_calls/splitting_report/Ecoli.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/bismark/methylation_calls/splitting_report/SRR389222.markdup.deduplicated_splitting_report.txt"),
                            path("$outputDir/cat/SRR389222.merged.fastq.gz"),
                            path("$outputDir/qualimap/Ecoli/genome_results.txt"),
                            path("$outputDir/qualimap/SRR389222/genome_results.txt")).match("clip_r1") },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml")).match("clip_r1_software_versions") },
                { assert new File("$outputDir/bismark/alignments/logs/Ecoli_1_val_1_bismark_bt2_PE_report.txt").exists() },
                { assert new File("$outputDir/bismark/alignments/logs/SRR389222_trimmed_bismark_bt2_SE_report.txt").exists() },
                { assert new File("$outputDir/bismark/reports/Ecoli_1_val_1_bismark_bt2_PE_report.html").exists() },
                { assert new File("$outputDir/bismark/reports/SRR389222_trimmed_bismark_bt2_SE_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.html").exists() },
                { assert new File("$outputDir/bismark/summary/bismark_summary_report.txt").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_1_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/Ecoli_2_fastqc.html").exists() },
                { assert new File("$outputDir/fastqc/SRR389222_fastqc.html").exists() },
                { assert new File("$outputDir/multiqc/bismark/multiqc_report.html").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_1.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/Ecoli_2.fastq.gz_trimming_report.txt").exists() },
                { assert new File("$outputDir/trimgalore/logs/SRR389222.fastq.gz_trimming_report.txt").exists() }
            )
        }
    }

    test("Bismark Filter Non-Conversion") {
        when {
            params {
                aligner               = "bismark"
                filter_non_conversion = true
                save_align_intermeds  = true
                run_methurator        = false
                outdir                = "$outputDir"
            }
        }

        then {
            def filtered = path("$outputDir/bismark/filter_non_converted").list().collect { file -> file.fileName.toString() }.sort()
            def versions = path("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml").text
            assertAll(
                { assert workflow.success },
                // One filtered BAM and one filtering report per sample
                { assert filtered.findAll { name -> name.endsWith(".nonCG_filtered.bam") }.size() == 2 },
                { assert filtered.findAll { name -> name.endsWith(".non-conversion_filtering.txt") }.size() == 2 },
                { assert filtered.any { name -> name.startsWith("Ecoli") } },
                { assert filtered.any { name -> name.startsWith("SRR389222") } },
                // The local modules report their versions through the versions topic
                { assert versions.contains("BISMARK_FILTER_NON_CONVERSION") },
                { assert versions.contains("SAMTOOLS_QUERYNAME_SORT") },
                { assert versions.contains("PICARD_MARKOPTICALDUPLICATES") },
                { assert snapshot(
                            filtered,
                            path("$outputDir/bismark/methylation_calls/bedGraph/Ecoli.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/bedGraph/SRR389222.markdup.deduplicated.bedGraph.gz"),
                            path("$outputDir/bismark/methylation_calls/mbias/Ecoli.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/mbias/SRR389222.markdup.deduplicated.M-bias.txt"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/Ecoli.markdup.deduplicated.bismark.cov.gz"),
                            path("$outputDir/bismark/methylation_calls/methylation_coverage/SRR389222.markdup.deduplicated.bismark.cov.gz")).match("filter_non_conversion") },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/methylseq_software_mqc_versions.yml")).match("filter_non_conversion_software_versions") }
            )
        }
    }
}
