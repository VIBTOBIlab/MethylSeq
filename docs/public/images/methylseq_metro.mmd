graph LR
    subgraph preprocessing [Pre-processing]
        reads_in[ ]
        cat_fastq[cat fastq]
        fastqc[FastQC]
        trimgalore[Trim Galore!]

        reads_in -->|bismark| cat_fastq
        reads_in -->|bwameth| cat_fastq
        cat_fastq -->|bismark| fastqc
        cat_fastq -->|bwameth| fastqc
        fastqc -->|bismark| trimgalore
        fastqc -->|bwameth| trimgalore
    end

    subgraph bismark_wf [Bismark: align and call methylation]
        fasta_bismark[ ]
        bismark_genomeprep[Bismark genome prep]
        bismark_align[Bismark align]
        bismark_filter[Filter non-conversion]
        picard_optical[Picard optical dups]
        bismark_dedup[Bismark deduplicate]
        bismark_methx[Methylation extractor]
        bismark_c2c[coverage2cytosine]
        bismark_report[Bismark report + summary]
        bismark_sort[SAMtools sort + index]

        fasta_bismark -->|bismark| bismark_genomeprep
        bismark_genomeprep -->|bismark| bismark_align
        bismark_align -->|bismark| bismark_filter
        bismark_filter -->|bismark| picard_optical
        picard_optical -->|bismark| bismark_dedup
        bismark_dedup -->|bismark| bismark_methx
        bismark_methx -->|bismark| bismark_c2c
        bismark_c2c -->|bismark| bismark_report
        bismark_report -->|bismark| bismark_sort
    end

    subgraph bwameth_wf [bwa-meth: align and call methylation]
        fasta_bwameth[ ]
        samtools_faidx[SAMtools faidx]
        bwameth_index[bwa-meth index]
        bwameth_align[bwa-meth align]
        bwameth_sort[SAMtools sort + index]
        bwameth_stats[SAMtools flagstat + stats]
        picard_markdup[Picard MarkDuplicates]
        methyldackel_extract[MethylDackel extract]
        methyldackel_mbias[MethylDackel mbias]

        fasta_bwameth -->|bwameth| samtools_faidx
        samtools_faidx -->|bwameth| bwameth_index
        bwameth_index -->|bwameth| bwameth_align
        bwameth_align -->|bwameth| bwameth_sort
        bwameth_sort -->|bwameth| bwameth_stats
        bwameth_stats -->|bwameth| picard_markdup
        picard_markdup -->|bwameth| methyldackel_extract
        methyldackel_extract -->|bwameth| methyldackel_mbias
    end

    subgraph qc_reporting [QC and reporting]
        qualimap[Qualimap BamQC]
        preseq[Preseq lc_extrap]
        methurator[Methurator]
        multiqc[MultiQC]
        report_out[ ]

        qualimap -->|bismark| preseq
        qualimap -->|bwameth| preseq
        preseq -->|bismark| methurator
        preseq -->|bwameth| methurator
        methurator -->|bismark| multiqc
        methurator -->|bwameth| multiqc
        multiqc -->|bismark| report_out
        multiqc -->|bwameth| report_out
    end

    %% Inter-section edges
    trimgalore -->|bismark| bismark_align
    trimgalore -->|bwameth| bwameth_align
    bismark_sort -->|bismark| qualimap
    methyldackel_mbias -->|bwameth| qualimap
