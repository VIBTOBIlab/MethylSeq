%%metro process: bismark_filter | BISMARK:BISMARK_FILTER_NON_CONVERSION
%%metro process: picard_optical | BISMARK:PICARD_MARKOPTICALDUPLICATES
%%metro process: bismark_dedup | BISMARK:BISMARK_DEDUPLICATE
%%metro process: bismark_sort | BISMARK:SAMTOOLS_SORT_.*
